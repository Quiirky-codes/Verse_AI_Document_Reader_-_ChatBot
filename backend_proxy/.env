PORT=4000
NODE_ENV=development
PYTHON_API_URL=http://localhost:5001
FRONTEND_URL=http://localhost:5173

# JWT secrets - set to long random values in production
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_REFRESH_SECRET=replace_with_other_long_random_string

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# HTTPS cert paths (for local dev put certs in ./certs/)
SSL_KEY_PATH=./certs/key.pem
SSL_CERT_PATH=./certs/cert.pem
